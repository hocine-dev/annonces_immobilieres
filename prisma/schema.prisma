generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. TABLES BETTER AUTH
// ==========================================

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Rôle : USER, AGENT ou ADMIN
  role Role @default(USER)

  banned    Boolean?  @default(false)
  banReason String?
  banExpires DateTime?

  // Relations Better Auth
  sessions Session[]
  accounts Account[]

  // Relations métier
  annonces  Annonce[]
  questions Question[]
  favoris   Favori[]

  @@map("user")
}

model Session {
  id             String   @id
  userId         String
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  impersonatedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ==========================================
// 2. ENUMS - IMMOBILIER
// ==========================================


enum Role {
  USER
  AGENT
  ADMIN
}

enum TypeBien {
  VENTE
  LOCATION
}

enum StatutPublication {
  BROUILLON
  PUBLIE
}

enum EtatBien {
  DISPONIBLE
  LOUE
  VENDU
}

// ==========================================
// 3. ANNONCES IMMOBILIÈRES
// ==========================================

model Annonce {
  id                String            @id @default(cuid())
  titre             String
  description       String            @db.Text
  type              TypeBien
  statut            StatutPublication @default(BROUILLON)
  etat              EtatBien          @default(DISPONIBLE)
  prix              Decimal           @db.Decimal(12, 2)
  dateDisponibilite DateTime          @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Auteur de l'annonce
  auteurId String
  auteur   User   @relation(fields: [auteurId], references: [id], onDelete: Cascade)

  // Relations
  photos    Photo[]
  questions Question[]
  favoris   Favori[]

  // Index pour les requêtes publiques
  @@index([statut, createdAt])

  @@map("annonce")
}

// ==========================================
// 4. PHOTOS
// ==========================================

model Photo {
  id  String @id @default(cuid())
  url String

  annonceId String
  annonce   Annonce @relation(fields: [annonceId], references: [id], onDelete: Cascade)

  @@map("photo")
}

// ==========================================
// 5. QUESTIONS
// ==========================================

model Question {
  id        String   @id @default(cuid())
  texte     String   @db.Text
  reponse   String?  @db.Text
  createdAt DateTime @default(now())

  auteurId String
  auteur   User   @relation(fields: [auteurId], references: [id], onDelete: Cascade)

  annonceId String
  annonce   Annonce @relation(fields: [annonceId], references: [id], onDelete: Cascade)

  @@map("question")
}

// ==========================================
// 6. FAVORIS
// ==========================================

model Favori {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  annonceId String
  annonce   Annonce @relation(fields: [annonceId], references: [id], onDelete: Cascade)

  // Un utilisateur ne peut avoir
  // qu'une seule fois la même annonce en favori
  @@unique([userId, annonceId])

  @@map("favori")
}