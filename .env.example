# PostgreSQL pour le développement local (utilisé par docker-compose.yml à la racine).
# Ces identifiants sont réservés au développement : choisissez des secrets forts en production.
POSTGRES_USER="immo"
POSTGRES_PASSWORD="immo"
POSTGRES_DB="immo"
# Port exposé sur la machine hôte ; changez-le si le port 5432 est déjà occupé.
POSTGRES_PORT="5432"
# Connexion utilisée par l'application et Prisma depuis la machine hôte.
DATABASE_URL="postgresql://immo:immo@localhost:5432/immo"
# URL à réserver à une base séparée pour les tests ; ne pointez jamais les tests vers la base réelle.
DATABASE_URL_TEST="postgresql://immo:immo@localhost:5432/immo_test"

# Secret de développement uniquement. En production, générez un secret aléatoire unique :
# openssl rand -base64 32
# Ne publiez jamais la valeur réelle de BETTER_AUTH_SECRET.
BETTER_AUTH_SECRET="secret_de_dev_a_changer"

# Comptes créés par le seed (prisma/seed.ts) ; utilisez des adresses distinctes.
# Les deux comptes agent et leurs mots de passe sont obligatoires pour exécuter le seed.
SEED_AGENT_1_EMAIL=agent1@horizon-immo.test
SEED_AGENT_1_PASSWORD=remplacer-par-un-mot-de-passe

SEED_AGENT_2_EMAIL=agent2@horizon-immo.test
SEED_AGENT_2_PASSWORD=remplacer-par-un-mot-de-passe

# Comptes USER de démonstration ; les deux emails et mots de passe sont requis par le seed.
SEED_USER_1_EMAIL=user1@example.test
SEED_USER_1_PASSWORD=remplacer-par-un-mot-de-passe
SEED_USER_2_EMAIL=user2@example.test
SEED_USER_2_PASSWORD=remplacer-par-un-mot-de-passe

# Compte ADMIN créé par le seed ; son mot de passe doit contenir au moins 12 caractères.
# Remplacez cette valeur vide avant d'exécuter le seed ou de déployer l'application.
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=remplacer-par-un-mot-de-passe
